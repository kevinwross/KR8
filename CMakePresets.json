{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-vs2026",
      "displayName": "Windows x64 (Visual Studio 2026)",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/windows-vs2026",
      "cacheVariables": {
        "KR8_BUILD_TESTS": "ON",
        "KR8_BUILD_UI": "ON"
      }
    },
    {
      "name": "windows-ninja",
      "displayName": "Windows x64 (Ninja + MSVC, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KR8_BUILD_TESTS": "ON",
        "KR8_BUILD_UI": "ON"
      }
    },
    {
      "name": "windows-ninja-release",
      "displayName": "Windows x64 (Ninja + MSVC, Release)",
      "inherits": "windows-ninja",
      "binaryDir": "${sourceDir}/build/windows-ninja-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux (GCC, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "KR8_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux (GCC, Release)",
      "inherits": "linux-gcc",
      "binaryDir": "${sourceDir}/build/linux-gcc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-gcc-sanitize",
      "displayName": "Linux (GCC, ASan/UBSan)",
      "inherits": "linux-gcc",
      "binaryDir": "${sourceDir}/build/linux-gcc-sanitize",
      "cacheVariables": {
        "KR8_SANITIZE": "ON",
        "KR8_BUILD_UI": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-vs2026-debug",
      "configurePreset": "windows-vs2026",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2026-release",
      "configurePreset": "windows-vs2026",
      "configuration": "Release"
    },
    {
      "name": "windows-ninja-debug",
      "configurePreset": "windows-ninja"
    },
    {
      "name": "windows-ninja-release",
      "configurePreset": "windows-ninja-release"
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc"
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc-release"
    },
    {
      "name": "linux-gcc-sanitize",
      "configurePreset": "linux-gcc-sanitize"
    }
  ],
  "testPresets": [
    {
      "name": "windows-vs2026-debug",
      "configurePreset": "windows-vs2026",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-vs2026-release",
      "configurePreset": "windows-vs2026",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-ninja-debug",
      "configurePreset": "windows-ninja",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-ninja-release",
      "configurePreset": "windows-ninja-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-gcc-sanitize",
      "configurePreset": "linux-gcc-sanitize",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
